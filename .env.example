# Copy to .env locally. Never commit the resulting file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/srm_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/srm_test
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24
TRUST_PROXY=false
# Required only for seeding. Choose strong passwords locally.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# Optional SMTP; messages remain queued while SMTP is unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
