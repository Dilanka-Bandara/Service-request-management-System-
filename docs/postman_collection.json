{
  "info": {
    "name": "Resolve Service Request API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sign in first; Postman stores the session cookie. Set local variables; never export passwords."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "attachmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register and sign in",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Member\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Invalidate session",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "List visible requests",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Create pending request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/requests",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"VPN connection issue\",\n  \"description\": \"The company VPN cannot establish a connection.\",\n  \"category\": \"TECHNICAL\",\n  \"priority\": \"HIGH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Counts by status and category",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests/stats",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Request details and history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests/{{requestId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Edit own pending request",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated request summary\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Soft cancel request",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/requests/{{requestId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin status transition",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"note\": \"Investigation started.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin user directory",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Admin role or activation change",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/users/{{userId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isActive\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Database readiness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Upload PDF, PNG or JPEG (5 MiB; five files per request)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/attachments",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "Authorized attachment download",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/attachments/{{attachmentId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    }
  ]
}
